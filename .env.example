# ======================================================================
# CONFIG  (Vercel type: Config)
# Safe to be visible. NEXT_PUBLIC_ values are built into the browser JavaScript anyway.
# Vercel environments: Production and Preview, except the Turnstile site key (Production only).
# ======================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Sentry error monitoring. Empty = Sentry off.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Cloudflare Turnstile bot check. Set together with TURNSTILE_SECRET_KEY, or leave both empty.
# Local testing key that always passes: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional: organization UUID powering the live "Ask the desk" row on the landing page. Read at build time.
DEMO_ORGANIZATION_ID=
# Optional: public base URL for links inside emails. Defaults to the URL the request came in on.
SITE_URL=
# Optional: for Sentry source map upload on Vercel.
SENTRY_ORG=
SENTRY_PROJECT=

# ======================================================================
# SECRET  (Vercel type: Secret)
# Server only. Never commit, never paste in chat, never rename with a NEXT_PUBLIC_ prefix.
# Vercel environments: Production and Preview, except TURNSTILE_SECRET_KEY (Production only).
# ======================================================================
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
GEMINI_API_KEY=your-gemini-api-key
N8N_ESCALATION_WEBHOOK_URL=https://your-n8n-host/webhook/your-omnidesk-path
# Optional: sent as the x-omnidesk-secret header; match it with a Header Auth credential on the n8n Webhook node.
N8N_WEBHOOK_SECRET=
# Local testing secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
# Optional: Sentry auth token for readable production stack traces.
SENTRY_AUTH_TOKEN=
