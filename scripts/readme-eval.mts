/** Copies the metrics table from evals/RESULTS.md into README.md between the EVAL_SUMMARY markers. */
import { readFileSync, writeFileSync } from "node:fs";

const results = readFileSync("evals/RESULTS.md", "utf8");
const lines = results.split("\n");
const start = lines.findIndex((line) => line.startsWith("| Metric |"));
const end = lines.findIndex((line, index) => index > start && line.trim() === "");
const context = lines.find((line) => line.startsWith("Generated by")) ?? "";
const models = lines.find((line) => line.startsWith("Embeddings:")) ?? "";
if (start < 0) throw new Error("No metrics table in evals/RESULTS.md");

const block = [
  "<!-- EVAL_SUMMARY_START -->",
  ...lines.slice(start, end),
  "",
  `${context.replace("Generated by `npm run eval` on", "Last run").trim()} ${models.trim()} Full per-question results: [evals/RESULTS.md](evals/RESULTS.md).`,
  "<!-- EVAL_SUMMARY_END -->",
].join("\n");

const readme = readFileSync("README.md", "utf8");
const updated = readme.replace(/<!-- EVAL_SUMMARY_START -->[\s\S]*?<!-- EVAL_SUMMARY_END -->/, block);
if (updated === readme && !readme.includes(block)) throw new Error("EVAL_SUMMARY markers not found in README.md");
writeFileSync("README.md", updated);
console.log("README eval summary updated.");
